{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "capitol-alpha-machine.vercel.app"
        }
      ],
      "destination": "https://capitolalpha.app/:path*",
      "permanent": true
    },
    {
      "source": "/data",
      "destination": "/methodology#data",
      "permanent": true
    },
    {
      "source": "/datasets/committee-risk",
      "destination": "/methodology#committee-risk",
      "permanent": true
    },
    {
      "source": "/exposure-index",
      "destination": "/scenes/exposure-index",
      "permanent": true
    },
    {
      "source": "/exposure-index.html",
      "destination": "/scenes/exposure-index",
      "permanent": true
    },
    {
      "source": "/the-ledger",
      "destination": "/scenes/the-ledger",
      "permanent": true
    },
    {
      "source": "/the-ledger.html",
      "destination": "/scenes/the-ledger",
      "permanent": true
    },
    {
      "source": "/capital-flow",
      "destination": "/scenes/capital-flow",
      "permanent": true
    },
    {
      "source": "/capital-flow.html",
      "destination": "/scenes/capital-flow",
      "permanent": true
    },
    {
      "source": "/returns-spectrum",
      "destination": "/scenes/returns-spectrum",
      "permanent": true
    },
    {
      "source": "/returns-spectrum.html",
      "destination": "/scenes/returns-spectrum",
      "permanent": true
    },
    {
      "source": "/timing-lattice",
      "destination": "/scenes/timing-lattice",
      "permanent": true
    },
    {
      "source": "/timing-lattice.html",
      "destination": "/scenes/timing-lattice",
      "permanent": true
    }
  ]
}
