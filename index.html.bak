.padStart(2,'0');\nconst a=v=>'rgba(255,255,255,'+clamp(v,0,1).toFixed(3)+')';\nconst CODES=DATA.codes, NS=CODES.length, MEM=DATA.members, NM=MEM.length;\nfunction rnd(){return Math.random();}\nfunction strobe(t,f,s,k){return Math.pow(Math.max(0,Math.sin((t*f+s)*Math.PI*2)),k);}\nfunction money(v){if(v>=1e6)return '$'+(v/1e6).toFixed(1)+'M';if(v>=1e3)return '$'+Math.round(v/1e3)+'K';return '$'+v;}\nfunction fit(text,x,y,maxW){let o=String(text);if(ctx.measureText(o).width<=maxW){ctx.fillText(o,x,y);return o;}const tl='…';while(o.length>1&&ctx.measureText(o+tl).width>maxW)o=o.slice(0,-1);ctx.fillText(o+tl,x,y);return o+tl;}\nMEM.forEach(m=>{m.maxLog=Math.max(1,...m.val.map(v=>Math.log10(v+1)));m.locked=[];for(let s=0;s<NS;s++)if(m.lock[s])m.locked.push(s);\n  m.seq=m.locked.slice();if(m.worst&&m.worst.si>=0){const i=m.seq.indexOf(m.worst.si);if(i>=0)m.seq.splice(i,1);m.seq.push(m.worst.si);} if(!m.seq.length)m.seq=[m.worst?m.worst.si:0];});\n\nfunction resize(){const r=cv.parentElement.getBoundingClientRect();W=Math.max(320,r.width);H=Math.max(360,r.height);DPR=Math.min(2,window.devicePixelRatio||1);cv.width=Math.floor(W*DPR);cv.height=Math.floor(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}\n\nfunction dotGrid(t){\n  ctx.save();\n  const xs=[],ys=[];\n  let x=-80,i=0;\n  const baseX=clamp(W*0.095,82,150);\n  while(x<W+120){\n    const stretch=0.72+0.62*((i*37)%97)/97;\n    x+=baseX*stretch;\n    xs.push(x);\n    i++;\n  }\n  let y=H*0.14,j=0;\n  const baseY=clamp(H*0.235,142,230);\n  while(y<H-40){\n    ys.push(y);\n    y+=baseY*(0.92+0.18*((j*29)%71)/71);\n    j++;\n  }\n  ctx.lineWidth=1.15;\n  for(let k=0;k<xs.length;k++){\n    const strong=k%5===1||k%7===0;\n    ctx.shadowColor='rgba(255,255,255,'+(strong?0.060:0.032)+')';\n    ctx.shadowBlur=strong?6:3;\n    ctx.strokeStyle=a(strong?0.090:0.046);\n    ctx.beginPath();ctx.moveTo(xs[k]+0.5,0);ctx.lineTo(xs[k]+0.5,H);ctx.stroke();\n  }\n  for(let k=0;k<ys.length;k++){\n    const strong=k%2===0;\n    ctx.shadowColor='rgba(255,255,255,'+(strong?0.070:0.042)+')';\n    ctx.shadowBlur=strong?7:4;\n    ctx.strokeStyle=a(strong?0.105:0.065);\n    ctx.beginPath();ctx.moveTo(0,ys[k]+0.5);ctx.lineTo(W,ys[k]+0.5);ctx.stroke();\n  }\n  ctx.shadowBlur=0;\n  ctx.fillStyle='rgba(255,255,255,0.026)';\n  const d=46;\n  for(let yy=d*0.5;yy<H;yy+=d)for(let xx=d*0.5;xx<W;xx+=d)ctx.fillRect(xx,yy,1,1);\n  ctx.lineWidth=1;\n  for(let yi=0;yi<ys.length;yi++)for(let xi=0;xi<xs.length;xi++){\n    const px=xs[xi],py=ys[yi];\n    if(px<0||px>W||py<0||py>H)continue;\n    const p=0.56+0.44*strobe(t,0.38,xi*0.17+yi*0.31,4);\n    const hot=((xi+yi*3)%8===0);\n    ctx.shadowColor='rgba(255,255,255,'+(hot?0.24*p:0.13*p).toFixed(3)+')';\n    ctx.shadowBlur=hot?13:7;\n    ctx.fillStyle=a(hot?0.38*p:0.22*p);\n    ctx.fillRect(px-1,py-1,2,2);\n    ctx.shadowBlur=0;\n    ctx.strokeStyle=a(hot?0.175*p:0.105*p);\n    ctx.beginPath();\n    ctx.moveTo(px-9,py);ctx.lineTo(px+9,py);\n    ctx.moveTo(px,py-9);ctx.lineTo(px,py+9);\n    ctx.stroke();\n  }\n  ctx.restore();\n}\n\nfunction geom(m){\n  const leftW=clamp(W*0.27,240,360);\n  const x0=leftW+36,x1=W-64,cw=(x1-x0)/NS;\n  const topRail=H*0.44,botRail=H*0.60,ovH=14,barMax=H*0.12;\n  const comY0=H*0.30,rowGap=clamp((H*0.55)/Math.max(4,m.coms.length),22,34),rowH=14;\n  const mx0=16+62,mxR=leftW-10,mcw=(mxR-mx0)/NS;\n  return {leftW,x0,x1,cw,topRail,botRail,ovH,barMax,comY0,rowGap,rowH,mx0,mxR,mcw};\n}\nconst barH=(m,g,s)=>6+(Math.log10(m.val[s]+1)/m.maxLog)*g.barMax;\nconst sx=(g,s)=>g.x0+g.cw*(s+0.5);\n\nfunction spine(g,m,reveal,t){\n  ctx.strokeStyle=a(0.10);ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(g.x0,g.topRail);ctx.lineTo(g.x1,g.topRail);ctx.moveTo(g.x0,g.botRail);ctx.lineTo(g.x1,g.botRail);ctx.stroke();\n  ctx.textAlign='right';ctx.fillStyle=a(0.34);ctx.font='8px '+MONO;\n  ctx.fillText('OVERSIGHT',g.x0-12,g.topRail-g.ovH-4);ctx.fillText('TRADES',g.x0-12,g.botRail+14);\n  ctx.textAlign='center';ctx.font='8px '+MONO;\n  for(let s=0;s<NS;s++){\n    const cx=sx(g,s),bw=g.cw*0.56,rv=clamp((reveal*NS-s)*1.5,0,1);if(rv<=0.02)continue;\n    if(m.jur[s]){ctx.fillStyle=a(0.42*rv);ctx.fillRect(cx-bw/2,g.topRail-g.ovH,bw,g.ovH);}\n    if(m.cnt[s]>0){const h=barH(m,g,s)*rv;ctx.fillStyle=a(0.40*rv);ctx.fillRect(cx-bw/2,g.botRail,bw,h);\n      ctx.fillStyle=a(0.28*rv);ctx.font='7px '+MONO;ctx.fillText(m.cnt[s]+'×',cx,g.botRail+h+9);ctx.font='8px '+MONO;}\n    const lock=m.lock[s];\n    ctx.fillStyle=a(lock?0.7:0.24);ctx.fillText(CODES[s],cx,(g.topRail+g.botRail)/2+3);\n    if(lock){const fl=0.34+0.5*strobe(t,7,s*1.7,3)+0.16*Math.sin(t*3+s);const h=barH(m,g,s);\n      ctx.fillStyle=a((0.30+fl*0.4)*rv);ctx.fillRect(cx-1,g.topRail-g.ovH,2,(g.botRail-g.topRail)+g.ovH+h);}\n  }\n}\n\nfunction committees(g,m,fs,t){\n  ctx.textAlign='left';\n  const respCi=fs>=0?m.resp[fs]:-1;\n  const titleCommittee=respCi>=0?m.coms[respCi].n.toUpperCase():(m.worst&&m.worst.committee?m.worst.committee.toUpperCase():'—');\n  ctx.fillStyle=a(0.96);ctx.font='18px '+MONO;fit(m.name,16,H*0.14,g.leftW-20);\n  ctx.fillStyle=a(0.78);ctx.font='10px '+MONO;fit(titleCommittee,16,H*0.14+16,g.leftW-20);\n  ctx.fillStyle=a(0.46);ctx.font='9px '+MONO;ctx.fillText(m.party+' · '+(m.chamber==='H'?'HOUSE':'SENATE')+' · '+m.state+'  ·  '+m.trades+' TRADES',16,H*0.14+31);\n  const vF=0.5+0.45*strobe(t,5,0,4);\n  ctx.fillStyle=a(m.nlock>0?(0.45+vF*0.45):0.4);ctx.font='9px '+MONO;\n  ctx.fillText(m.nlock>0?('REGISTERED · '+m.nlock+'/'+NS+' SECTORS'):'NO REGISTRATION',16,H*0.14+44);\n  for(let ci=0;ci<m.coms.length;ci++){\n    const c=m.coms[ci],ry=g.comY0+ci*g.rowGap,on=ci===respCi;\n    const fl=on?(0.62+0.10*strobe(t,5,ci,4)):0.32;\n    ctx.fillStyle=a(fl);ctx.font='9px '+MONO;ctx.fillText(c.c,16,ry+g.rowH-3);\n    for(let s=0;s<NS;s++){const mx=g.mx0+s*g.mcw;const has=c.j[s];const isfs=on&&s===fs;\n      ctx.fillStyle=a(has?(isfs?(0.72+0.08*strobe(t,5.5,s,4)):(on?0.42:0.22)):0.06);\n      ctx.fillRect(mx+0.5,ry,Math.max(1.5,g.mcw-1.5),g.rowH);}\n    if(on){ctx.strokeStyle=a(0.22+0.05*strobe(t,4.5,ci,4));ctx.lineWidth=1;ctx.strokeRect(13.5,ry-1.5,g.leftW-22,g.rowH+3);}\n  }\n}\n\nfunction chain(g,m,fs,emph,t){\n  if(fs<0)return;const ci=m.resp[fs];const cx=sx(g,fs);const h=barH(m,g,fs);\n  const oy=g.topRail-g.ovH,bw=g.cw*0.56;\n  const sp=0.5+0.5*strobe(t,12,fs,2);\n  const A=0.55+0.4*sp+(emph?0.05:0);\n  if(ci>=0){\n    const ry=g.comY0+ci*g.rowGap+g.rowH/2;const ox=g.mx0+(fs+0.5)*g.mcw;\n    ctx.strokeStyle=a(A);ctx.lineWidth=emph?1.4:1;ctx.setLineDash([5,5]);ctx.lineDashOffset=-t*22;\n    ctx.beginPath();ctx.moveTo(ox,ry);ctx.quadraticCurveTo((ox+cx)/2,ry,cx,oy-3);ctx.stroke();ctx.setLineDash([]);\n  }\n  ctx.fillStyle=a(0.65+sp*0.35);ctx.fillRect(cx-bw/2,oy,bw,g.ovH);\n  ctx.fillStyle=a(0.8+sp*0.2);ctx.fillRect(cx-2,oy,4,(g.botRail-oy)+h);\n  ctx.fillStyle=a(0.6+sp*0.35);ctx.fillRect(cx-bw/2,g.botRail,bw,h);\n  ctx.strokeStyle=a(0.9);ctx.lineWidth=1;\n  ctx.strokeRect(cx-bw/2-3,oy-3,bw+6,g.ovH+6);ctx.strokeRect(cx-bw/2-3,g.botRail-1,bw+6,h+5);\n  ctx.strokeStyle=a(0.18+0.2*sp);ctx.strokeRect(g.x0+g.cw*fs+1,oy-9,g.cw-2,(g.botRail-g.topRail)+g.ovH+h+20);\n  const code=ci>=0?m.coms[ci].c:'—';\n  ctx.textAlign='center';ctx.font='9px '+MONO;ctx.fillStyle=a(0.7+0.3*strobe(t,10,fs,2));\n  ctx.fillText(code+' ▸ '+CODES[fs],cx,oy-12);\n  if(emph&&m.worst&&fs===m.worst.si){ctx.fillStyle=a(0.85+0.15*sp);ctx.font='9px '+MONO;ctx.fillText(m.worst.ticker,cx,g.botRail+h+20);}\n}\n\nfunction sectorRisk(m,fs){\n  if(m.worst&&m.worst.si===fs)return m.worst.risk;\n  const maxCnt=Math.max(1,...m.cnt);\n  const vol=Math.log10((m.val[fs]||0)+1)/Math.max(1,m.maxLog);\n  const rep=(m.cnt[fs]||0)/maxCnt;\n  return Math.round(clamp(58+vol*25+rep*14+(m.resp[fs]>=0?7:0),0,99));\n}\nfunction relatedTrade(m,fs){\n  const w=m.worst;\n  if(fs<0&&w)return {...w,aggregate:false};\n  const ci=fs>=0?m.resp[fs]:-1;\n  const committee=ci>=0?m.coms[ci].n:(w&&w.committee?w.committee:'—');\n  if(w&&w.si===fs)return {...w,committee,aggregate:false};\n  const sector=CODES[fs]||'—';\n  const sectorName=((DATA.sectors[fs]||sector).replace(/-/g,' ')+' sector disclosures').toUpperCase();\n  const span=DATA.meta.window.split(' / ');\n  return {ticker:sector,issuer:sectorName,sector,committee,side:'FLOW',value:m.val[fs]||0,txDate:span[0]||'—',pub:span[1]||'—',gap:null,rep:m.cnt[fs]||0,risk:sectorRisk(m,fs),flags:['committee-sector-overlap','sector-disclosed-volume','aggregate-related-lock'],aggregate:true};\n}\n\nfunction readout(m,fs,fade,t){\n  const w=relatedTrade(m,fs);if(!w)return;\n  const pw=clamp(W*0.30,300,420),ph=192,px=W-pw-18,py=H-ph-52;\n  const fl=0.85+0.15*strobe(t,4,0.3,6);\n  ctx.save();ctx.globalAlpha=fade;\n  ctx.fillStyle='rgba(0,0,0,0.90)';ctx.fillRect(px,py,pw,ph);\n  ctx.fillStyle='rgba(0,0,0,0.34)';ctx.fillRect(px+1,py+1,pw-2,ph-2);\n  ctx.strokeStyle=a(0.24);ctx.strokeRect(px+.5,py+.5,pw-1,ph-1);\n  ctx.strokeStyle=a(0.10);ctx.strokeRect(px+4.5,py+4.5,pw-9,ph-9);\n  ctx.textAlign='left';\n  ctx.fillStyle=a(fl);ctx.font='12px '+MONO;fit(w.aggregate?(w.ticker+' · '+w.committee.toUpperCase()):(w.ticker+' · '+w.sector),px+14,py+24,pw-28);\n  ctx.fillStyle=a(0.50);ctx.font='9px '+MONO;fit(w.issuer.toUpperCase(),px+14,py+38,pw-28);\n  ctx.fillStyle=a(0.34);ctx.font='8px '+MONO;fit((w.aggregate?'RELATED SECTOR FLOW':'RELATED FLAGGED TRADE')+' · VIA '+w.committee.toUpperCase(),px+14,py+52,pw-28);\n  const rows=w.aggregate\n    ? [['RELATED VALUE',money(w.value)],['TRADE COUNT',w.rep+'×'],['WINDOW START',w.txDate],['WINDOW END',w.pub],['LOCK SECTOR',w.sector],['SIGNAL SCORE',z2(w.risk)+'/100']]\n    : [['SIDE · VALUE',w.side+' '+money(w.value)],['TRADE DATE',w.txDate],['DISCLOSED',w.pub],['REPORTING GAP',w.gap+'D'],['REPEAT 90D',w.rep+'×'],['RISK SCORE',z2(w.risk)+'/100']];\n  ctx.font='10px '+MONO;\n  for(let i=0;i<rows.length;i++){const yy=py+70+i*14;ctx.textAlign='left';ctx.fillStyle=a(0.44);ctx.fillText(rows[i][0],px+14,yy);ctx.textAlign='right';const hot=rows[i][0]==='RISK SCORE'||rows[i][0]==='SIGNAL SCORE'||rows[i][0]==='REPORTING GAP';ctx.fillStyle=hot?a(0.9+0.1*strobe(t,8,i,3)):a(0.78);ctx.fillText(rows[i][1],px+pw-14,yy);}\n  ctx.textAlign='left';ctx.fillStyle=a(0.40);ctx.font='7px '+MONO;fit((w.flags||[]).join(' · ').toUpperCase(),px+14,py+ph-22,pw-28);\n  const bw=pw-28;ctx.fillStyle=a(0.14);ctx.fillRect(px+14,py+ph-13,bw,2);ctx.fillStyle=a(0.84);ctx.fillRect(px+14,py+ph-13,bw*(w.risk/100),2);\n  ctx.restore();\n}\n\nfunction chrome(idx,t){\n  ctx.textAlign='left';\n  ctx.fillStyle=a(0.92);ctx.font='12px '+MONO;ctx.fillText('CT · CONFLICT REGISTER',16,28);\n  ctx.fillStyle=a(0.45);ctx.font='9px '+MONO;ctx.fillText('SCENE 03 / COMMITTEE → SECTOR → DISCLOSED TRADE',16,42);\n  ctx.fillStyle=a(0.30);ctx.fillText('REAL — CAPITOL TRADES · COMMITTEE-RISK JOIN · '+DATA.meta.window,16,54);\n  ctx.fillStyle=a(0.16);for(let i=0;i<14;i++){const x=W-14-i*7;ctx.fillRect(x,16,2,(i%5===0)?11:5);}\n  ctx.textAlign='right';ctx.fillStyle=a(0.50);ctx.font='9px '+MONO;ctx.fillText('MEMBER '+z2(idx+1)+'/'+z2(NM),W-14,40);\n  ctx.fillStyle=a(0.18);ctx.fillRect(W-246,H-17,228,2);ctx.fillStyle=a(0.70);ctx.fillRect(W-246,H-17,228*((idx+1)/NM),2);\n  ctx.textAlign='left';ctx.fillStyle=a(0.50);ctx.font='9px '+MONO;\n  ctx.fillText('CROSSED '+z2(crossed),16,H-28);ctx.fillText('FLAGGED VOL $'+Math.round(volAcc).toLocaleString('en-US'),16,H-14);\n  ctx.fillStyle=a(0.26);ctx.textAlign='right';ctx.font='7px '+MONO;ctx.fillText(DATA.meta.note.toUpperCase(),W-14,H-14);\n}\n\nfunction noise(n,al){ctx.fillStyle=a(al);for(let i=0;i<n;i++){ctx.fillRect(rnd()*W,rnd()*H,1,1);}}\nfunction glitch(energy,t){\n  if(energy<=0.015&&rnd()>0.06)return;\n  const e=Math.max(energy,0.05);\n  ctx.save();ctx.setTransform(1,0,0,1,0,0);\n  const Wd=cv.width,Hd=cv.height,bands=1+Math.floor(e*7);\n  for(let i=0;i<bands;i++){const y=Math.floor(rnd()*Hd),h=Math.floor((3+rnd()*34)*DPR),dx=Math.floor((rnd()-0.5)*70*DPR*e);\n    try{ctx.drawImage(cv,0,y,Wd,h,dx,y,Wd,h);}catch(_){}\n    if(rnd()<0.4){ctx.fillStyle=a(0.06+rnd()*0.12);ctx.fillRect(0,y,Wd,1*DPR);}}\n  if(rnd()<e*0.7){const y=Math.floor(rnd()*Hd);ctx.fillStyle=a(0.5+rnd()*0.4);ctx.fillRect(0,y,Wd,Math.floor(1.5*DPR));}\n  ctx.restore();\n  noise(Math.floor(20+e*60),0.05+e*0.06);\n}\n\nlet crossed=0,volAcc=0,t0=null,prev=0,step=null,lastFi=-1,glE=0,flash=0;\nconst REVEAL=0.55,LOCK_HOLD=3.0,DEPART=0.42;\nlet order=[],op=0;\nfunction reshuffle(){order=MEM.map((_,i)=>i);for(let i=order.length-1;i>0;i--){const j=Math.floor(rnd()*(i+1));[order[i],order[j]]=[order[j],order[i]];}op=0;}\n\nfunction frame(ts){\n  if(t0===null){t0=ts;prev=ts;}\n  const t=(ts-t0)/1000,dt=Math.min(0.05,(ts-prev)/1000);prev=ts;\n  if(!order.length)reshuffle();\n  if(step===null){step={i:order[op]};const m0=MEM[step.i];step.hold=Math.max(1,m0.seq.length)*LOCK_HOLD;step.stepDur=LOCK_HOLD;step.start=t;flash=1;glE=1;lastFi=-1;}\n  const m=MEM[step.i];const total=REVEAL+step.hold+DEPART;const el=t-step.start;\n  if(el>total){op++;if(op>=order.length)reshuffle();step={i:order[op]};const mn=MEM[step.i];step.hold=Math.max(1,mn.seq.length)*LOCK_HOLD;step.stepDur=LOCK_HOLD;step.start=t;crossed=Math.min(NM*99,crossed+1);flash=1;glE=1;lastFi=-1;return requestAnimationFrame(frame);}\n  const g=geom(m);\n  let reveal,fade,fs=-1,emph=false;\n  if(el<REVEAL){reveal=smooth(el/REVEAL);fade=clamp(el/REVEAL,0,1);}\n  else if(el<REVEAL+step.hold){reveal=1;fade=1;const fi=clamp(Math.floor((el-REVEAL)/step.stepDur),0,m.seq.length-1);fs=m.seq[fi];emph=(fi===m.seq.length-1);if(fi!==lastFi){lastFi=fi;glE=Math.max(glE,0.8);flash=Math.max(flash,0.5);}}\n  else{reveal=1;fade=clamp((total-el)/DEPART,0,1);glE=Math.max(glE,0.5);}\n  volAcc=Math.min(MEM.reduce((s,x)=>s+x.conflictVal,0),volAcc+dt*4.0e6);\n  glE=Math.max(0,glE-dt*2.2);flash=Math.max(0,flash-dt*5.5);\n\n  ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);\n  dotGrid(t);\n  ctx.save();ctx.globalAlpha=fade;\n  spine(g,m,reveal,t);\n  committees(g,m,fs,t);\n  if(fs>=0)chain(g,m,fs,emph,t);\n  ctx.restore();\n  readout(m,fs,fade,t);\n  chrome(step.i,t);\n  requestAnimationFrame(frame);\n}\nresize();window.addEventListener('resize',resize);requestAnimationFrame(frame);\n<\/script>\n<\/body>\n<\/html>\n"</script>
<script id="scene04-html" type="application/json">"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Scene 04 — Returns Spectrum<\/title>\n<style id=\"fullscreen-base\">\n:root { color-scheme: dark; }\nhtml, body { width:100%; height:100%; margin:0; padding:0; overflow:hidden; background:#000; }\nbody { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace; }\n.rs-wrap { position:fixed !important; inset:0 !important; width:100vw !important; height:100vh !important; min-height:0 !important; overflow:hidden !important; background:#000 !important; }\n.rs-wrap canvas { display:block !important; width:100% !important; height:100% !important; }\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}\n<\/style>\n<\/head>\n<body>\n<h2 class=\"sr-only\">Scene 04, Returns Spectrum: a black-and-white spectrogram of real Capitol Trades disclosures across a three-year trade window, with current real trailing-ninety-day issuer returns and a real current SPY EOD baseline. Rows represent current members, bright pulses indicate larger observed excess returns, and the lock panel shows real trade data. The visual alpha score is derived from observed return magnitude, disclosed value, and member frequency.<\/h2>\n<div class=\"rs-wrap\"><canvas id=\"rs-canvas\"><\/canvas><\/div>\n<script>\nconst cv=document.getElementById('rs-canvas');\nconst ctx=cv.getContext('2d');\nlet W=0,H=0,DPR=1;\nconst MONO='ui-monospace, Menlo, Consolas, monospace';\nfunction mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\nconst RNG=mulberry32(0xA17A5A04);\nfunction randn(){let u=0,v=0;while(u===0)u=RNG();while(v===0)v=RNG();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);}\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst z2=n=>String(n).padStart(2,'0');\nconst z4=n=>String(n).padStart(4,'0');\nconst PJ=window.__CAPITOL_TRADES_SCENE04__;\nconst T0=Date.parse(PJ.meta.from+'T00:00:00Z'), T1=Date.parse(PJ.meta.to+'T00:00:00Z')+86400000, SPAN=Math.max(86400000,T1-T0);\nfunction fmtPct(v){return (v>=0?'+':'')+(v*100).toFixed(1)+'%';}\nfunction amountBand(v){return v<15000?'SMALL':v<100000?'MEDIUM':v<500000?'LARGE':'WHALE';}\nfunction dateLabel(ms){const d=new Date(ms);return d.getUTCFullYear()+'.'+z2(d.getUTCMonth()+1)+'.'+z2(d.getUTCDate());}\nconst ROWS=PJ.MEM.map((name,i)=>({i,name,short:name.split(' ').slice(-1)[0],trades:[],avg:0,total:0,count:0}));\nconst TRADES=PJ.TR.map((raw,i)=>{\n  const row=ROWS[raw.member], ms=Date.parse(raw.date+'T00:00:00Z');\n  const tr={row:raw.member,member:row.name,short:row.short,ticker:PJ.TICK[raw.ticker],amount:raw.amount,buy:raw.buy,ms,market:raw.market,ret90:raw.ret90,excess:raw.excess,alpha:0,signal:0,seed:(i*7919)%9999};\n  row.trades.push(tr);row.total+=tr.amount;row.avg+=tr.excess;row.count++;return tr;\n});\nROWS.forEach(row=>{if(row.count)row.avg/=row.count;});\nTRADES.forEach(tr=>{const row=ROWS[tr.row],freqBoost=clamp(row.count/24,0,1),amountBoost=clamp(Math.log10(Math.max(1,tr.amount))/6,0,1);tr.alpha=clamp(Math.abs(tr.excess)*2.2+amountBoost*.30+freqBoost*.18,0,1);tr.signal=clamp(Math.abs(tr.excess)*2.8+amountBoost*.36+freqBoost*.16,0,1);});\nTRADES.sort((a,b)=>a.ms-b.ms);\nconst HOT=TRADES.filter(t=>t.alpha>0.58);\nlet plot={x0:150,x1:900,top:80,bottom:600,rowGap:20,rowH:10};\nlet lock=null,lastLockedRow=-1,nextLock=1.25,tradeCount=0,volCount=0,t0=null,prev=0;\nfunction resize(){\n  const r=cv.parentElement.getBoundingClientRect();W=Math.max(320,r.width);H=Math.max(360,r.height);DPR=Math.min(2,window.devicePixelRatio||1);\n  cv.width=W*DPR;cv.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);\n  plot.x0=clamp(W*0.18,116,230);plot.x1=W-72;plot.top=H*0.145;plot.bottom=H*0.825;\n  plot.rowGap=(plot.bottom-plot.top)/(ROWS.length-1);plot.rowH=clamp(plot.rowGap*0.42,5,14);\n}\nfunction xOf(ms){return plot.x0+((ms-T0)/SPAN)*(plot.x1-plot.x0);}\nfunction yOf(row){return plot.top+row*plot.rowGap;}\nfunction dotGrid(){ctx.fillStyle='rgba(255,255,255,0.045)';const g=44;for(let y=g*.5;y<H;y+=g){for(let x=g*.5;x<W;x+=g)ctx.fillRect(x,y,1,1);}}\nfunction vignette(){}\nfunction marketY(x,t){return H*.50+Math.sin(x*.010+t*.42)*H*.028+Math.sin(x*.024-t*.31)*H*.012;}\nfunction drawBaseline(t){\n  ctx.save();ctx.globalCompositeOperation='screen';\n  ctx.strokeStyle='rgba(255,255,255,0.160)';ctx.lineWidth=1;ctx.beginPath();\n  for(let x=plot.x0;x<=plot.x1;x+=4){const y=marketY(x,t);x===plot.x0?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke();\n  ctx.strokeStyle='rgba(255,255,255,0.090)';ctx.lineWidth=8;ctx.beginPath();\n  for(let x=plot.x0;x<=plot.x1;x+=8){const y=marketY(x,t);x===plot.x0?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke();\n  ctx.restore();\n  ctx.fillStyle='rgba(255,255,255,0.38)';ctx.font='9px '+MONO;ctx.textAlign='right';ctx.fillText('SPY EOD BASELINE PULSE',plot.x1,H*.50-18);\n}\nfunction drawRows(t){\n  ctx.textAlign='left';ctx.font='9px '+MONO;\n  for(const r of ROWS){\n    const y=yOf(r.i);\n    const active=lock&&lock.tr.row===r.i;\n    const fade=active?clamp(Math.min((t-lock.start)*5,(lock.end-t)*5),0,1):0;\n    ctx.strokeStyle=active?'rgba(255,255,255,'+(0.12+0.18*fade).toFixed(3)+')':'rgba(255,255,255,0.075)';\n    ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(plot.x0,y);ctx.lineTo(plot.x1,y);ctx.stroke();\n    const hot=r.avg>0.045;\n    if(active){\n      ctx.save();\n      ctx.shadowColor='rgba(255,255,255,0.72)';\n      ctx.shadowBlur=8*fade;\n      ctx.fillStyle='rgba(255,255,255,'+(0.72+0.28*fade).toFixed(3)+')';\n      ctx.fillRect(9,y-6,2,12);\n      ctx.fillText(r.short,16,y+3);\n      ctx.restore();\n    }else{\n      ctx.fillStyle=hot?'rgba(255,255,255,0.60)':'rgba(255,255,255,0.34)';ctx.fillText(r.short,16,y+3);\n    }\n    ctx.fillStyle=active?'rgba(255,255,255,'+(0.40+0.42*fade).toFixed(3)+')':'rgba(255,255,255,0.22)';\n    ctx.textAlign='right';ctx.fillText(fmtPct(r.avg),plot.x0-10,y+3);ctx.textAlign='left';\n  }\n}\nfunction drawTimeAxis(){\n  ctx.strokeStyle='rgba(255,255,255,0.12)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(plot.x0,plot.bottom+24);ctx.lineTo(plot.x1,plot.bottom+24);ctx.stroke();\n  ctx.font='9px '+MONO;ctx.fillStyle='rgba(255,255,255,0.32)';ctx.textAlign='center';\n  const start=new Date(T0),end=new Date(T1);\n  let tick=Date.UTC(start.getUTCFullYear(),start.getUTCMonth(),1);\n  for(;tick<=T1;){const d=new Date(tick),x=xOf(tick);ctx.fillRect(x,plot.bottom+18,1,12);ctx.fillText(d.getUTCFullYear()+'.'+z2(d.getUTCMonth()+1),x,plot.bottom+44);tick=Date.UTC(d.getUTCFullYear(),d.getUTCMonth()+3,1);}\n}\nfunction tradeAlpha(tr,tt){\n  const tw=0.5+0.5*Math.sin(tt*1.7+tr.seed);\n  const sign=tr.excess>=0?1:0.55;\n  return clamp(0.08+tr.signal*0.48+tr.alpha*0.25+tw*0.13,0.05,0.95)*sign;\n}\nfunction drawSpectrogram(t){\n  const clusterW=54;\n  for(const tr of TRADES){\n    let tt=t;\n    if(lock&&(tr.row===lock.tr.row||Math.abs(xOf(tr.ms)-lock.x)<clusterW))tt=lock.freezeT;\n    const x=xOf(tr.ms),y=yOf(tr.row);\n    if(x<plot.x0-20||x>plot.x1+20)continue;\n    const intensity=tradeAlpha(tr,tt);\n    const h=plot.rowH*(0.6+tr.signal*1.85);\n    const w=tr.alpha>.78?2.2:1.25;\n    const jitter=Math.sin(tt*2.2+tr.seed)*1.15;\n    ctx.fillStyle='rgba(255,255,255,'+intensity.toFixed(3)+')';\n    ctx.fillRect(x-w/2,y-h/2+jitter,w,h);\n    if(tr.excess<0){ctx.fillStyle='rgba(0,0,0,0.55)';ctx.fillRect(x-w/2-1,y-1,w+2,2);}\n    // High-alpha trades stay as thin spectrogram bars; circular bloom/glowing blobs removed.\n  }\n}\nfunction randomReadoutPosition(anchorX,anchorY,pw,ph){\n  const margin=18;\n  const minX=margin,maxX=Math.max(margin,W-pw-margin);\n  const minY=margin,maxY=Math.max(margin,H-ph-margin-18);\n  let px=minX,py=minY;\n  for(let i=0;i<10;i++){\n    px=minX+RNG()*(maxX-minX);\n    py=minY+RNG()*(maxY-minY);\n    const cx=px+pw*0.5,cy=py+ph*0.5;\n    const tooClose=Math.abs(cx-anchorX)<pw*0.70&&Math.abs(cy-anchorY)<ph*0.85;\n    if(!tooClose)break;\n  }\n  return {px,py};\n}\nfunction updateLock(t){\n  if(lock&&t>lock.end){lock=null;nextLock=t+0.45+RNG()*0.95;}\n  if(!lock&&t>nextLock){\n    const hotPool=HOT.filter(candidate=>candidate.row!==lastLockedRow);\n    const tradePool=TRADES.filter(candidate=>candidate.row!==lastLockedRow);\n    const pool=hotPool.length?hotPool:tradePool;\n    const tr=pool[Math.floor(RNG()*pool.length)]||TRADES[0];\n    const x=xOf(tr.ms),y=yOf(tr.row);\n    const pw=clamp(W*0.30,280,410),ph=154;\n    const pos=randomReadoutPosition(x,y,pw,ph);\n    const duration=3.25+RNG()*1.35;\n    lock={tr,start:t,end:t+duration,freezeT:t,x,y,readoutX:pos.px,readoutY:pos.py};\n    lastLockedRow=tr.row;\n  }\n}\nfunction drawScanner(t){\n  const sx=plot.x0+(((t*0.055)%1))*(plot.x1-plot.x0);\n  ctx.strokeStyle='rgba(255,255,255,0.24)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(sx,plot.top-18);ctx.lineTo(sx,plot.bottom+18);ctx.stroke();\n  ctx.fillStyle='rgba(255,255,255,0.55)';ctx.fillRect(sx-1,plot.top-21,2,6);ctx.fillRect(sx-1,plot.bottom+15,2,6);\n  if(!lock)return;\n  const tr=lock.tr,x=lock.x,y=lock.y,bw=86,bh=plot.rowH*3.4;\n  const fade=clamp(Math.min((t-lock.start)*5,(lock.end-t)*5),0,1);\n  ctx.save();ctx.globalAlpha=fade;\n  ctx.strokeStyle='rgba(255,255,255,0.72)';ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(plot.x0,y);ctx.lineTo(x-bw*.5,y);ctx.moveTo(x+bw*.5,y);ctx.lineTo(plot.x1,y);ctx.stroke();\n  ctx.strokeStyle='rgba(255,255,255,0.95)';ctx.strokeRect(x-bw*.5,y-bh*.5,bw,bh);\n  ctx.strokeStyle='rgba(255,255,255,0.18)';ctx.strokeRect(x-bw*.5-8,y-bh*.5-8,bw+16,bh+16);\n  ctx.fillStyle='rgba(255,255,255,0.08)';ctx.fillRect(plot.x0,y-plot.rowH*.85,plot.x1-plot.x0,plot.rowH*1.7);\n  ctx.fillStyle='rgba(255,255,255,0.95)';ctx.font='10px '+MONO;ctx.textAlign='left';ctx.fillText('LOCK '+z4(tr.row+1)+' / '+tr.short,x+bw*.5+12,y-8);\n  ctx.fillStyle='rgba(255,255,255,0.48)';ctx.fillText(dateLabel(tr.ms)+' · '+tr.ticker,x+bw*.5+12,y+6);\n  ctx.restore();\n}\nfunction drawReadout(t){\n  if(!lock)return;\n  const tr=lock.tr;const fade=clamp(Math.min((t-lock.start)*4,(lock.end-t)*4),0,1);\n  const pw=clamp(W*0.30,280,410),ph=154;\n  const px=clamp(lock.readoutX??(W-pw-18),18,Math.max(18,W-pw-18));\n  const py=clamp(lock.readoutY??18,18,Math.max(18,H-ph-18));\n  ctx.save();ctx.globalAlpha=fade;\n  ctx.fillStyle='rgba(0,0,0,0.90)';ctx.fillRect(px,py,pw,ph);\n  ctx.fillStyle='rgba(0,0,0,0.34)';ctx.fillRect(px+1,py+1,pw-2,ph-2);\n  ctx.strokeStyle='rgba(255,255,255,0.24)';ctx.strokeRect(px+.5,py+.5,pw-1,ph-1);\n  ctx.strokeStyle='rgba(255,255,255,0.10)';ctx.strokeRect(px+4.5,py+4.5,pw-9,ph-9);\n  ctx.fillStyle='rgba(255,255,255,0.94)';ctx.font='12px '+MONO;ctx.textAlign='left';ctx.fillText(tr.member+' · '+tr.ticker,px+14,py+24);\n  ctx.fillStyle='rgba(255,255,255,0.52)';ctx.font='9px '+MONO;ctx.fillText('TRAILING 90D RETURN VS SPY EOD BASELINE',px+14,py+40);\n  const rows=[['90D RETURN',fmtPct(tr.ret90)],['SPY BASELINE',fmtPct(tr.market)],['EXCESS ALPHA',fmtPct(tr.excess)],['ALPHA SCORE',tr.alpha.toFixed(2)],['TRADE BAND',amountBand(tr.amount)],['SCORE','DERIVED FROM REAL EOD']];\n  ctx.font='10px '+MONO;\n  for(let i=0;i<rows.length;i++){\n    const yy=py+62+i*15;ctx.fillStyle='rgba(255,255,255,0.44)';ctx.fillText(rows[i][0],px+14,yy);ctx.fillStyle=i===2?'rgba(255,255,255,0.99)':'rgba(255,255,255,0.78)';ctx.textAlign='right';ctx.fillText(rows[i][1],px+pw-14,yy);ctx.textAlign='left';\n  }\n  const barW=pw-28;ctx.fillStyle='rgba(255,255,255,0.14)';ctx.fillRect(px+14,py+ph-13,barW,2);ctx.fillStyle='rgba(255,255,255,0.82)';ctx.fillRect(px+14,py+ph-13,barW*tr.alpha,2);\n  ctx.restore();\n}\nfunction chrome(t){\n  ctx.fillStyle='rgba(255,255,255,0.92)';ctx.font='12px '+MONO;ctx.textAlign='left';ctx.fillText('CT · RETURNS SPECTRUM',16,28);\n  ctx.fillStyle='rgba(255,255,255,0.45)';ctx.font='9px '+MONO;ctx.fillText('SCENE 04 / MEMBER ROWS × TRAILING 90D EXCESS RETURN',16,42);\n  ctx.fillStyle='rgba(255,255,255,0.30)';ctx.fillText('REAL CAPITOL TRADES · 3Y TRADE WINDOW · CURRENT 90D EOD RETURNS',16,54);\n  ctx.textAlign='right';ctx.fillStyle='rgba(255,255,255,0.50)';\n  ctx.fillText('TRADES '+z4(tradeCount),W-16,H-28);ctx.fillText('VOL $'+Math.round(volCount/1000000)+'M',W-16,H-14);\n  ctx.fillStyle='rgba(255,255,255,0.18)';for(let i=0;i<14;i++){const x=W-18-i*7;ctx.fillRect(x,18,2,(i%5===0)?11:5);}\n}\nfunction frame(ts){\n  if(t0===null){t0=ts;prev=ts;}const t=(ts-t0)/1000,dt=Math.min(.05,(ts-prev)/1000);prev=ts;\n  updateLock(t);tradeCount=Math.min(TRADES.length,Math.floor(tradeCount+dt*22));volCount=Math.min(ROWS.reduce((a,r)=>a+r.total,0),volCount+dt*9800000);\n  ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);\n  dotGrid();drawBaseline(t);drawRows(t);drawSpectrogram(t);drawScanner(t);drawTimeAxis();drawReadout(t);chrome(t);\n  requestAnimationFrame(frame);\n}\nresize();window.addEventListener('resize',resize);requestAnimationFrame(frame);\n<\/script>\n<\/body>\n<\/html>"</script>
<script id="scene05-html" type="application/json">"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Scene 05 — Timing Lattice<\/title>\n<style id=\"fullscreen-base\">\n:root { color-scheme: dark; }\nhtml, body { width:100%; height:100%; margin:0; padding:0; overflow:hidden; background:#000; }\nbody { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace; }\n.tl-wrap { position:fixed !important; inset:0 !important; width:100vw !important; height:100vh !important; min-height:0 !important; overflow:hidden !important; background:#000 !important; }\n.tl-wrap canvas { display:block !important; width:100% !important; height:100% !important; }\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}\n<\/style>\n<\/head>\n<body>\n<h2 class=\"sr-only\">Scene 05, Timing Lattice: black-and-white data field linking real Congress.gov public-law events to real Capitol Trades disclosures. Public laws sit on an upper event spine and real trades occupy sector lanes below. Each trade draws a faint derived line to a nearby legislative event; the active reading head steps through real events, ignites nearby trade links, then locks onto the strongest timing and sector proximity link. Scores are visualization heuristics only, not evidence of causation or unlawful conduct.<\/h2>\n<div class=\"tl-wrap\"><canvas id=\"tl-canvas\"><\/canvas><\/div>\n<script>\nconst cv=document.getElementById('tl-canvas');\nconst ctx=cv.getContext('2d');\nlet W=0,H=0,DPR=1;\nconst DATA=window.__CAPITOL_TRADES_SCENE05__ || {meta:{},sectors:[],events:[],trades:[]};\nconst MONO='ui-monospace, Menlo, Consolas, monospace';\nfunction mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\nconst RNG=mulberry32(0x705C0DE5);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst smooth=x=>{x=clamp(x,0,1);return x*x*(3-2*x);};\nconst z2=n=>String(n).padStart(2,'0');\nconst z4=n=>String(n).padStart(4,'0');\nconst DAY=86400000;\nfunction fmtUSD(v){if(v>=1e6)return '$'+(v/1e6).toFixed(1)+'M';if(v>=1e3)return '$'+Math.round(v/1e3)+'K';return '$'+Math.round(v||0).toLocaleString('en-US');}\nfunction dateLabel(ms){const d=new Date(ms);return d.getUTCFullYear()+'.'+z2(d.getUTCMonth()+1)+'.'+z2(d.getUTCDate());}\nfunction amountBand(v){return v>=10000000?'WHALE':v>=1000000?'MEGA':v>=375000?'LARGE':v>=75000?'MEDIUM':'SMALL';}\nfunction fit(text,x,y,maxW,align){let out=String(text||'—');ctx.textAlign=align||'left';if(ctx.measureText(out).width<=maxW){ctx.fillText(out,x,y);return;}const tail='...';while(out.length>1&&ctx.measureText(out+tail).width>maxW)out=out.slice(0,-1);ctx.fillText(out+tail,x,y);}\nfunction normParty(p){return p==='D'||p==='R'||p==='I'?p:'?';}\n\nconst SECTOR_META=(DATA.sectors&&DATA.sectors.length?DATA.sectors:[\n  {key:'communication-services',code:'COMM'},{key:'consumer-discretionary',code:'DISC'},{key:'consumer-staples',code:'STPL'},{key:'energy',code:'ENGY'},{key:'financials',code:'FIN'},{key:'health-care',code:'HLTH'},{key:'industrials',code:'INDU'},{key:'information-technology',code:'TECH'},{key:'materials',code:'MATL'},{key:'real-estate',code:'RE'},{key:'utilities',code:'UTIL'}\n]);\nconst SECTORS=SECTOR_META.map(s=>s.key);\nconst SCODE={};const SECI={};SECTOR_META.forEach((s,i)=>{SCODE[s.key]=s.code;SECI[s.key]=i;});\nconst EVENTS=(DATA.events||[]).map((e,i)=>({...e,i,ms:+e.ms||Date.parse(e.date+'T00:00:00Z'),fan:[],worst:null}));\nconst EBY=new Map(EVENTS.map(e=>[e.id,e]));\nconst TRADES=(DATA.trades||[]).map((t,i)=>{\n  const ev=EBY.get(t.eventId)||EVENTS[0];\n  const ms=+t.ms||Date.parse(t.txDate+'T00:00:00Z');\n  const pubMs=+t.pubMs||Date.parse((t.pubDate||t.txDate)+'T00:00:00Z');\n  const gap=(ms-(ev?ev.ms:ms))/DAY;\n  const abs=Math.abs(gap);\n  const closeness=clamp(t.closeness!==undefined?t.closeness:(1-abs/135),0,1);\n  const score=clamp((t.timingScore||t.riskScore||60)/100,0,1);\n  return {...t,id:i,ev,ms,pubMs,eventGap:gap,absGap:abs,closeness,score,party:normParty(t.party),yj:(t.yj||0)};\n});\nTRADES.forEach(t=>{if(t.ev)t.ev.fan.push(t);});\nEVENTS.forEach(e=>{e.worst=e.fan.slice().sort((a,b)=>(b.timingScore||0)-(a.timingScore||0)||b.closeness-a.closeness)[0]||null;});\nconst EVT=EVENTS.filter(e=>e.worst).sort((a,b)=>a.ms-b.ms);EVT.forEach((e,i)=>e.ord=i);\nconst allMs=[...EVT.map(e=>e.ms),...TRADES.map(t=>t.ms)].filter(Number.isFinite);\nconst T0=(allMs.length?Math.min(...allMs):Date.UTC(2024,0,1))-28*DAY;\nconst T1=(allMs.length?Math.max(...allMs):Date.UTC(2025,11,31))+28*DAY;\nconst SPAN=Math.max(DAY,T1-T0);\nconst totalVol=TRADES.reduce((s,t)=>s+(t.value||0),0);\nconst FLAGGED=TRADES.filter(t=>(t.timingScore||0)>=75).length;\nconst RANK=TRADES.slice().sort((a,b)=>(b.timingScore||0)-(a.timingScore||0)||(b.riskScore||0)-(a.riskScore||0));RANK.forEach((t,i)=>t.rank=i+1);\n\nlet P={x0:120,x1:900,eY:160,bandTop:300,bandBottom:640,laneH:48,axisY:680};\nlet t0=null,prev=0,tradeCount=0,volCount=0;\nconst IGNITE=0.62,HOLD_MIN=1.5,HOLD_MAX=4.7,DEPART=0.5;\nfunction holdFor(ev){const s=ev&&ev.worst?((ev.worst.timingScore||60)/100):0.45;return HOLD_MIN+(HOLD_MAX-HOLD_MIN)*smooth(s);}\nlet step=null,order=[],op=0,visited=new Set();\nfunction reshuffle(){order=EVT.map((_,i)=>i);for(let i=order.length-1;i>0;i--){const j=Math.floor(RNG()*(i+1));[order[i],order[j]]=[order[j],order[i]];}op=0;visited=new Set();}\n\nfunction resize(){\n  const r=cv.parentElement.getBoundingClientRect();\n  W=Math.max(320,r.width);H=Math.max(360,r.height);DPR=Math.min(2,window.devicePixelRatio||1);\n  cv.width=W*DPR;cv.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);\n  P.x0=clamp(W*0.13,92,174);P.x1=W-64;P.eY=H*0.245;\n  P.bandTop=H*0.405;P.bandBottom=H*0.815;P.laneH=(P.bandBottom-P.bandTop)/SECTORS.length;P.axisY=H*0.88;\n}\nfunction xOf(ms){return P.x0+((ms-T0)/SPAN)*(P.x1-P.x0);}\nfunction laneY(sec){return P.bandTop+((SECI[sec]??0)+0.5)*P.laneH;}\nfunction tradeY(tr){return laneY(tr.sector)+tr.yj*P.laneH*0.34;}\nfunction readoutDims(){return {pw:clamp(W*0.34,330,470),ph:236};}\n\nfunction dotGrid(){ctx.fillStyle='rgba(255,255,255,0.040)';const g=44;for(let y=g*.5;y<H;y+=g)for(let x=g*.5;x<W;x+=g)ctx.fillRect(x,y,1,1);}\nfunction laneGuides(){\n  ctx.font='8px '+MONO;\n  for(let s=0;s<SECTORS.length;s++){\n    const y=P.bandTop+(s+0.5)*P.laneH;\n    ctx.strokeStyle='rgba(255,255,255,0.050)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(P.x0,y);ctx.lineTo(P.x1,y);ctx.stroke();\n    ctx.fillStyle='rgba(255,255,255,0.30)';ctx.textAlign='right';ctx.fillText(SCODE[SECTORS[s]],P.x0-10,y+3);\n  }\n  ctx.strokeStyle='rgba(255,255,255,0.10)';ctx.lineWidth=1;ctx.strokeRect(P.x0,P.bandTop,P.x1-P.x0,P.bandBottom-P.bandTop);\n}\nfunction sineSweep(t){\n  ctx.save();ctx.strokeStyle='rgba(255,255,255,0.045)';ctx.lineWidth=1;ctx.beginPath();\n  const my=lerp(P.eY,P.bandTop,0.5);\n  for(let x=P.x0;x<=P.x1;x+=5){const y=my+Math.sin(x*0.012+t*0.5)*8+Math.sin(x*0.031-t*0.32)*4;x===P.x0?ctx.moveTo(x,y):ctx.lineTo(x,y);}\n  ctx.stroke();ctx.restore();\n}\nfunction drawLattice(t,active,igniteP,env,lockTr){\n  const breathe=0.86+0.14*Math.sin(t*0.7);ctx.lineWidth=1;\n  for(const tr of TRADES){\n    const tx=xOf(tr.ms),ty=tradeY(tr);if(tx<P.x0-6||tx>P.x1+6)continue;\n    const ex=xOf(tr.ev.ms),onActive=tr.ev.id===active.id,isLock=lockTr&&lockTr.id===tr.id;\n    const shimmer=0.82+0.18*Math.sin(t*1.35+tr.seed);\n    let a,ma;\n    if(isLock){a=0.96;ma=0.99;}\n    else if(onActive){\n      const reveal=clamp((tr.closeness-(1-igniteP-0.10))/0.20,0,1);\n      a=(0.045+Math.pow(tr.closeness,1.45)*0.48+(tr.match?tr.closeness*0.20:0))*env*reveal*breathe*shimmer;\n      ma=clamp((0.18+tr.closeness*0.52+(tr.match?0.18:0))*env*reveal,0.10,0.95);\n    }else{a=0.020*breathe*shimmer;ma=0.11;}\n    ctx.strokeStyle='rgba(255,255,255,'+clamp(a,0.012,0.97).toFixed(3)+')';ctx.beginPath();ctx.moveTo(tx,ty);ctx.lineTo(ex,P.eY);ctx.stroke();\n    const big=(tr.timingScore||0)>=78;const s=(isLock||big)?2.5:1.35;\n    ctx.fillStyle='rgba(255,255,255,'+clamp(ma,0.08,1).toFixed(3)+')';ctx.fillRect(tx-s/2,ty-s/2,s,s);\n    if(!tr.buy){ctx.fillStyle='rgba(0,0,0,0.64)';ctx.fillRect(tx-s/2,ty-0.5,s,1);}\n  }\n}\nfunction drawEventSpine(t,active,env){\n  ctx.strokeStyle='rgba(255,255,255,0.20)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(P.x0,P.eY);ctx.lineTo(P.x1,P.eY);ctx.stroke();\n  const ax=xOf(active.ms);ctx.strokeStyle='rgba(255,255,255,'+(0.10*env).toFixed(3)+')';ctx.beginPath();ctx.moveTo(ax,P.eY);ctx.lineTo(ax,P.bandTop);ctx.stroke();\n  ctx.font='8px '+MONO;\n  for(const e of EVT){\n    const ex=xOf(e.ms),isA=e.id===active.id,h=12+e.sig*24,a=isA?0.96:0.18+e.sig*0.14;\n    ctx.strokeStyle='rgba(255,255,255,'+a.toFixed(3)+')';ctx.lineWidth=isA?1.55:1;ctx.beginPath();ctx.moveTo(ex,P.eY);ctx.lineTo(ex,P.eY-h);ctx.stroke();\n    ctx.fillStyle='rgba(255,255,255,'+a.toFixed(3)+')';ctx.fillRect(ex-1.4,P.eY-1.4,2.8,2.8);\n    ctx.save();ctx.translate(ex,P.eY-h-5);ctx.rotate(-Math.PI/2);ctx.textAlign='left';ctx.fillStyle='rgba(255,255,255,'+(isA?0.96:0.28).toFixed(3)+')';ctx.fillText(e.code,0,3);ctx.restore();\n  }\n  ctx.textAlign='right';ctx.fillStyle='rgba(255,255,255,0.28)';ctx.font='9px '+MONO;ctx.fillText('REAL CONGRESS.GOV PUBLIC LAWS',P.x1,P.eY-2);\n  ctx.textAlign='left';ctx.fillStyle='rgba(255,255,255,0.28)';ctx.fillText('REAL CAPITOL TRADES × SECTOR LANE',P.x0,P.bandBottom+16);\n}\nfunction drawTimeAxis(){\n  ctx.strokeStyle='rgba(255,255,255,0.12)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(P.x0,P.axisY);ctx.lineTo(P.x1,P.axisY);ctx.stroke();\n  ctx.font='9px '+MONO;ctx.fillStyle='rgba(255,255,255,0.32)';ctx.textAlign='center';\n  const start=new Date(T0);let y=start.getUTCFullYear(),m=Math.floor(start.getUTCMonth()/3)*3;\n  for(let k=0;k<18;k++){const ms=Date.UTC(y,m,1);if(ms>T1+DAY)break;if(ms>=T0-DAY){const x=xOf(ms);ctx.fillRect(x,P.axisY-6,1,12);ctx.fillText(y+'.'+z2(m+1),x,P.axisY+18);}m+=3;if(m>=12){m=0;y++;}}\n}\nfunction randomReadoutPosition(ax,ay,pw,ph){\n  const margin=18,minX=margin,maxX=Math.max(margin,W-pw-margin),minY=margin,maxY=Math.max(margin,H-ph-margin-18);let px=minX,py=minY;\n  for(let i=0;i<12;i++){px=minX+RNG()*(maxX-minX);py=minY+RNG()*(maxY-minY);const cx=px+pw*0.5,cy=py+ph*0.5;if(!(Math.abs(cx-ax)<pw*0.72&&Math.abs(cy-ay)<ph*0.9))break;}\n  return {px,py};\n}\nfunction drawFocus(t,active,focus){\n  const tr=active.worst;if(!tr||focus<=0)return;const tx=xOf(tr.ms),ty=tradeY(tr),ex=xOf(active.ms);\n  ctx.save();ctx.globalAlpha=focus;ctx.strokeStyle='rgba(255,255,255,0.95)';ctx.lineWidth=1.35;ctx.beginPath();ctx.moveTo(tx,ty);ctx.lineTo(ex,P.eY);ctx.stroke();\n  const tb=Math.max(12,P.laneH*0.58);ctx.lineWidth=1;ctx.strokeStyle='rgba(255,255,255,0.95)';ctx.strokeRect(tx-tb*.5,ty-tb*.5,tb,tb);ctx.strokeStyle='rgba(255,255,255,0.18)';ctx.strokeRect(tx-tb*.5-7,ty-tb*.5-7,tb+14,tb+14);\n  ctx.strokeStyle='rgba(255,255,255,0.54)';ctx.beginPath();ctx.moveTo(tx,ty+tb*.5);ctx.lineTo(tx,P.axisY);ctx.stroke();\n  ctx.fillStyle='rgba(255,255,255,0.80)';ctx.font='9px '+MONO;ctx.textAlign='center';ctx.fillText(dateLabel(tr.ms),tx,P.axisY+30);\n  ctx.strokeStyle='rgba(255,255,255,0.38)';ctx.beginPath();ctx.moveTo(P.x0,laneY(tr.sector));ctx.lineTo(tx-tb*.5,ty);ctx.stroke();\n  const mx=(tx+ex)/2,my=(ty+P.eY)/2;ctx.fillStyle='rgba(0,0,0,0.86)';ctx.fillRect(mx-36,my-8,72,15);ctx.strokeStyle='rgba(255,255,255,0.50)';ctx.strokeRect(mx-36,my-8,72,15);\n  ctx.fillStyle='rgba(255,255,255,0.95)';ctx.font='9px '+MONO;const g=Math.round(tr.absGap);ctx.fillText((tr.eventGap<0?'-':'+')+g+'D '+(tr.eventGap<0?'PRE':'POST'),mx,my+3);ctx.restore();\n}\nfunction drawReadout(t,active,focus){\n  const tr=active.worst;if(!tr||focus<=0)return;const dim=readoutDims(),pw=dim.pw,ph=dim.ph,pos=step.readout||{px:18,py:18};const px=clamp(pos.px,18,Math.max(18,W-pw-18)),py=clamp(pos.py,18,Math.max(18,H-ph-18));\n  ctx.save();ctx.globalAlpha=focus;ctx.fillStyle='rgba(0,0,0,0.90)';ctx.fillRect(px,py,pw,ph);ctx.fillStyle='rgba(0,0,0,0.34)';ctx.fillRect(px+1,py+1,pw-2,ph-2);ctx.strokeStyle='rgba(255,255,255,0.24)';ctx.strokeRect(px+.5,py+.5,pw-1,ph-1);ctx.strokeStyle='rgba(255,255,255,0.10)';ctx.strokeRect(px+4.5,py+4.5,pw-9,ph-9);\n  ctx.textAlign='left';ctx.fillStyle='rgba(255,255,255,0.96)';ctx.font='12px '+MONO;fit(tr.member+' ('+tr.party+')',px+14,py+24,pw-28);\n  ctx.fillStyle='rgba(255,255,255,0.54)';ctx.font='9px '+MONO;fit('REAL LINK · '+active.bill+' · '+active.id,px+14,py+39,pw-28);\n  const rows=[\n    ['COMMITTEE',tr.committee],['TICKER · SECTOR',tr.ticker+' · '+(SCODE[tr.sector]||tr.sector)],['ISSUER',tr.issuer],['SIDE · BAND',(tr.buy?'BUY':'SELL')+' · '+amountBand(tr.value)],['AMOUNT',fmtUSD(tr.value)],['TRADE DATE',dateLabel(tr.ms)],['DISCLOSED',tr.pubMs?dateLabel(tr.pubMs):'—'],['PUBLIC LAW DATE',dateLabel(active.ms)],['Δ DAYS',(tr.eventGap<0?'-':'+')+Math.round(tr.absGap)+'D ('+(tr.eventGap<0?'BEFORE':'AFTER')+')'],['RISK · LINK',(tr.riskScore||0)+'/100 · #'+tr.rank]\n  ];\n  ctx.font='10px '+MONO;\n  for(let i=0;i<rows.length;i++){const yy=py+58+i*14;ctx.fillStyle='rgba(255,255,255,0.44)';ctx.textAlign='left';fit(rows[i][0],px+14,yy,pw*0.42);const hot=rows[i][0]==='RISK · LINK'||rows[i][0]==='Δ DAYS';ctx.fillStyle=hot?'rgba(255,255,255,0.99)':'rgba(255,255,255,0.80)';ctx.textAlign='right';fit(rows[i][1],px+pw-14,yy,pw*0.48,'right');}\n  ctx.textAlign='left';ctx.fillStyle='rgba(255,255,255,0.34)';ctx.font='8px '+MONO;fit(active.full.toUpperCase(),px+14,py+ph-27,pw-28);\n  const barW=pw-28;ctx.fillStyle='rgba(255,255,255,0.14)';ctx.fillRect(px+14,py+ph-15,barW,2);ctx.fillStyle='rgba(255,255,255,0.85)';ctx.fillRect(px+14,py+ph-15,barW*clamp((tr.timingScore||0)/100,0,1),2);\n  ctx.fillStyle='rgba(255,255,255,0.28)';ctx.font='7px '+MONO;fit('DERIVED TIMING/SECTOR PROXIMITY · NOT CAUSATION',px+14,py+ph-5,pw-28);ctx.restore();\n}\nfunction chrome(t,active){\n  ctx.textAlign='left';ctx.fillStyle='rgba(255,255,255,0.92)';ctx.font='12px '+MONO;ctx.fillText('CT · TIMING LATTICE',16,28);\n  ctx.fillStyle='rgba(255,255,255,0.45)';ctx.font='9px '+MONO;ctx.fillText('SCENE 05 / PUBLIC LAW EVENTS × REAL TRADES',16,42);\n  ctx.fillStyle='rgba(255,255,255,0.30)';ctx.fillText('REAL — CONGRESS.GOV + CAPITOL TRADES · DERIVED TIMING/SECTOR LINK',16,54);\n  ctx.fillStyle='rgba(255,255,255,0.70)';ctx.font='10px '+MONO;fit('READING ▸ '+z2(op+1)+'/'+z2(EVT.length)+'  '+active.full+'  '+dateLabel(active.ms),16,72,W-32);\n  const sx=16,sy=80,seg=7,gap=3;for(let i=0;i<EVT.length;i++){const isCur=(i===step.ei),seen=visited.has(i);ctx.fillStyle=isCur?'rgba(255,255,255,0.95)':seen?'rgba(255,255,255,0.45)':'rgba(255,255,255,0.16)';ctx.fillRect(sx+i*(seg+gap),sy,seg,3);}\n  ctx.textAlign='right';ctx.fillStyle='rgba(255,255,255,0.50)';ctx.font='9px '+MONO;ctx.fillText('TRADES '+z4(tradeCount),W-16,H-42);ctx.fillText('FLAGGED '+z4(FLAGGED),W-16,H-28);ctx.fillText('VOL $'+Math.round(volCount/1000000)+'M',W-16,H-14);\n  ctx.fillStyle='rgba(255,255,255,0.18)';for(let i=0;i<14;i++){const x=W-18-i*7;ctx.fillRect(x,18,2,(i%5===0)?11:5);}\n}\nfunction advance(t){\n  const el=t-step.start;if(step.phase==='ignite'&&el>IGNITE){step.phase='hold';step.start=t;const e=EVT[step.ei];step.hold=holdFor(e);if(e.worst){const dim=readoutDims();step.readout=randomReadoutPosition(xOf(e.worst.ms),tradeY(e.worst),dim.pw,dim.ph);}}\n  else if(step.phase==='hold'&&el>(step.hold||HOLD_MIN)){step.phase='depart';step.start=t;}\n  else if(step.phase==='depart'&&el>DEPART){const prev=step.ei;op++;if(op>=order.length){reshuffle();if(order.length>1&&order[0]===prev)[order[0],order[1]]=[order[1],order[0]];}step.ei=order[op];visited.add(step.ei);step.phase='ignite';step.start=t;}\n}\nfunction frame(ts){\n  if(t0===null){t0=ts;prev=ts;}const t=(ts-t0)/1000,dt=Math.min(.05,(ts-prev)/1000);prev=ts;\n  if(step===null){reshuffle();visited.add(order[0]);step={ei:order[0],phase:'ignite',start:t,hold:HOLD_MIN,readout:{px:18,py:18}};}\n  if(!EVT.length){ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);ctx.fillStyle='rgba(255,255,255,0.8)';ctx.font='12px '+MONO;ctx.fillText('NO REAL SCENE 05 DATA',16,28);return;}\n  advance(t);const active=EVT[step.ei],el=t-step.start;let igniteP,env,focus;\n  if(step.phase==='ignite'){igniteP=clamp(el/IGNITE,0,1);env=smooth(igniteP);focus=0;}else if(step.phase==='hold'){igniteP=1;env=1;const hd=step.hold||HOLD_MIN,h=clamp(el/hd,0,1);focus=clamp(Math.min(h*6,(1-h)*5+0.4),0,1);}else{igniteP=1;const d=clamp(el/DEPART,0,1);env=1-smooth(d);focus=clamp(1-d*1.4,0,1);}const lockTr=focus>0.02?active.worst:null;\n  tradeCount=Math.min(TRADES.length,Math.floor(tradeCount+dt*70));volCount=Math.min(totalVol,volCount+dt*(totalVol/16));\n  ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);dotGrid();laneGuides();sineSweep(t);drawLattice(t,active,igniteP,env,lockTr);drawEventSpine(t,active,env);drawTimeAxis();drawFocus(t,active,focus);drawReadout(t,active,focus);chrome(t,active);requestAnimationFrame(frame);\n}\nresize();window.addEventListener('resize',resize);requestAnimationFrame(frame);\n<\/script>\n<\/body>\n<\/html>\n"</script>
<header class="app-menu">
  <div class="brand">
    <h1 class="brand-title">CAPITOL ALPHA MACHINE</h1>
    <div class="brand-subtitle">TRADING DATA FROM CAPITOLTRADES.COM</div>
  </div>
  <nav class="scene-switcher" aria-label="Choose animation">
    <button class="scene-button" type="button" data-scene="scene01" aria-pressed="true">01 · Capital Flow</button>
    <button class="scene-button" type="button" data-scene="scene02" aria-pressed="false">02 · The Ledger</button>
    <button class="scene-button" type="button" data-scene="scene03" aria-pressed="false">03 · Conflict Register</button>
    <button class="scene-button" type="button" data-scene="scene04" aria-pressed="false">04 · Returns Spectrum</button>
    <button class="scene-button" type="button" data-scene="scene05" aria-pressed="false">05 · Timing Lattice</button>
  </nav>
</header>
<main class="stage" aria-live="polite">
  <iframe id="scene-frame" title="Capitol Trades Data animation" sandbox="allow-scripts"></iframe>
  <div class="copyright-mark" aria-hidden="true">&copy;2026 s.belahniche</div>
</main>
<script src="./capitoltrades_data.js?v=scene05-real-events-20260604"></script>
<script>
const frame = document.getElementById('scene-frame');
const buttons = Array.from(document.querySelectorAll('.scene-button'));
const scenes = {
  scene01: JSON.parse(document.getElementById('scene01-html').textContent).replace('window.__CAPITOL_TRADES_SCENE01__', JSON.stringify(window.CAPITOL_TRADES_SCENE01)),
  scene02: JSON.parse(document.getElementById('scene02-html').textContent).replace('window.__CAPITOL_TRADES_SCENE02__', JSON.stringify(window.CAPITOL_TRADES_SCENE02)),
  scene03: JSON.parse(document.getElementById('scene03-html').textContent),
  scene04: JSON.parse(document.getElementById('scene04-html').textContent).replace('window.__CAPITOL_TRADES_SCENE04__', JSON.stringify(window.CAPITOL_TRADES_SCENE04)),
  scene05: JSON.parse(document.getElementById('scene05-html').textContent).replace('window.__CAPITOL_TRADES_SCENE05__', JSON.stringify(window.CAPITOL_TRADES_SCENE05))
};
function showScene(id) {
  frame.srcdoc = scenes[id];
  buttons.forEach(btn => btn.setAttribute('aria-pressed', String(btn.dataset.scene === id)));
}
buttons.forEach(btn => btn.addEventListener('click', () => showScene(btn.dataset.scene)));
showScene('scene01');
</script>
</body>
</html>
